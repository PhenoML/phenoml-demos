# PhenoML OAuth client credentials (current `phenoml` SDK).
# Get these from the PhenoML Developer Console: https://console.pheno.ml
PHENOML_CLIENT_ID=
PHENOML_CLIENT_SECRET=

# Your PhenoML instance base URL.
PHENOML_BASE_URL=https://experiment.app.pheno.ml

# The PhenoStore FHIR provider ID this app should query against.
PHENOSTORE_PROVIDER_ID=

# Optional: reuse one PhenoAgent across runs instead of creating a new one each time.
PHENOSTORE_AGENT_ID=

# Optional: port for the web server (default 3000).
# PORT=3000
