# PhenoML API credentials — OAuth client credentials (SDK v15.x)
# Get these from your PhenoML developer console.
PHENOML_CLIENT_ID=your_client_id_here
PHENOML_CLIENT_SECRET=your_client_secret_here

# Optional: point the SDK at a specific instance.
# Leave unset to use the SDK's default environment (experiment.app.pheno.ml).
# Example for a dedicated instance: https://your-org.app.pheno.ml
PHENOML_BASE_URL=

# FHIR provider UUID the agents and FHIR proxy read/write against.
# On shared/experiment instances the default sandbox provider is used if this is
# blank; on a dedicated instance set it to your configured provider id.
PHENOML_FHIR_PROVIDER_ID=your_fhir_provider_uuid_here

# Optional: point the demo at a LIVE CDS Hooks server instead of the in-process shim.
# Leave blank to run simulated (step2/step3 call cds_hooks_server/evaluate.py directly, no
# extra process). Set to a running shim, e.g. http://localhost:8088, to POST the order-select
# / order-sign envelopes over HTTP (start it with: uvicorn cds_hooks_server.main:app --port 8088).
CDS_HOOKS_URL=
