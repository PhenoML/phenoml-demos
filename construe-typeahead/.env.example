# PhenoML Construe credentials — OAuth client credentials (SDK v15.x).
# Get these from your PhenoML developer console.
# Copy this file to `.env` and fill in your instance credentials.
#
# These are read SERVER-SIDE ONLY (by server/construeProxy via vite.config.ts)
# and are NEVER shipped to the browser. Note: no VITE_ prefix — that prefix is
# exactly what would inline a value into the client bundle, so we avoid it for
# secrets. The browser only ever calls the same-origin /api/* proxy.
PHENOML_CLIENT_ID=your_client_id_here
PHENOML_CLIENT_SECRET=your_client_secret_here

# Optional: point at a specific instance.
# Leave unset to use the default environment (experiment.app.pheno.ml).
# Example for a dedicated instance: https://your-org.app.pheno.ml
PHENOML_BASE_URL=
