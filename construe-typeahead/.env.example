# PhenoML Construe credentials — OAuth client credentials (SDK v15.x).
# Get these from your PhenoML developer console.
# Copy this file to `.env` and fill in your instance credentials. The VITE_
# prefix is required: Vite only exposes VITE_-prefixed vars to the browser at
# dev/build time, and these seed the in-app Settings panel.
#
# WARNING: the client secret is sent from the browser in Live mode. This is for
# internal/dev use only — do NOT paste production credentials, and do NOT ship a
# build that bakes these into a public link.
VITE_PHENOML_CLIENT_ID=your_client_id_here
VITE_PHENOML_CLIENT_SECRET=your_client_secret_here

# Optional: point at a specific instance.
# Leave unset to use the default environment (experiment.app.pheno.ml).
# Example for a dedicated instance: https://your-org.app.pheno.ml
VITE_PHENOML_BASE_URL=
